#include <iostream>
#include <vector>
#include <algorithm>

using namespace std;

int main() {
    int a;
    cin >> a;
    vector<int> b(a);
    int c = 0, d = 101;
    int e = -1, f = -1;

    for (int i = 0; i < a; ++i) {
        cin >> b[i];
        if (b[i] > c) {
            c = b[i];
            e = i;
        }
    }

    for (int i = a - 1; i >= 0; --i) {
        if (b[i] < d) {
            d = b[i];
            f = i;
        }
    }

    int swaps = e + (a - 1 - f);
    if (e > f) {
        swaps--;
    }

    cout << swaps << endl;

    return 0;
}
