#include <iostream>
#include <string>

using namespace std;

int main() {
    string p;
    cin >> p;

    bool produces_output = false;
    for (char c : p) {
        if (c == 'H' || c == 'Q' || c == '9') {
            produces_output = true;
            break;
        }
    }

    if (produces_output) {
        cout << "YES" << endl;
    } else {
        cout << "NO" << endl;
    }

    return 0;
}
