#include <iostream>
#include <vector>
#include <algorithm>

using namespace std;

int main() {
    int n;
    cin >> n;
    vector<int> heights(n);
    for (int i = 0; i < n; ++i) {
        cin >> heights[i];
    }

    int maxWatered = 0;
    for (int i = 0; i < n; ++i) {
        int currentWatered = 1;
        
        for (int j = i - 1; j >= 0; --j) {
            if (heights[j] <= heights[j + 1]) {
                currentWatered++;
            } else {
                break;
            }
        }

        for (int j = i + 1; j < n; ++j) {
            if (heights[j] <= heights[j - 1]) {
                currentWatered++;
            } else {
                break;
            }
        }
        
        maxWatered = max(maxWatered, currentWatered);
    }
    
    cout << maxWatered << endl;

    return 0;
}
