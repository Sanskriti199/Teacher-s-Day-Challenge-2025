#include <iostream>

using namespace std;

int main() {
    long long k, n, w;
    cin >> k >> n >> w;
    long long total_cost = k * w * (w + 1) / 2;
    long long borrow_amount = 0;
    if (total_cost > n) {
        borrow_amount = total_cost - n;
    }
    cout << borrow_amount << endl;
    return 0;
}
