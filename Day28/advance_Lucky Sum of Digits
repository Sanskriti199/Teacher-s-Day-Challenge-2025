#include <iostream>
#include <string>
#include <algorithm>

using namespace std;

int main() {
    int n;
    cin >> n;

    for (int b = n / 7; b >= 0; --b) {
        int remaining_sum = n - 7 * b;
        if (remaining_sum >= 0 && remaining_sum % 4 == 0) {
            int a = remaining_sum / 4;
            for (int i = 0; i < a; ++i) {
                cout << '4';
            }
            for (int i = 0; i < b; ++i) {
                cout << '7';
            }
            cout << endl;
            return 0;
        }
    }

    cout << -1 << endl;

    return 0;
}
