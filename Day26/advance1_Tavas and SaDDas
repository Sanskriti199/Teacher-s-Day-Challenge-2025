#include <iostream>
#include <string>
#include <cmath>

using namespace std;

int main() {
    string n_str;
    cin >> n_str;
    int len = n_str.length();
    long long total_count = (1LL << len) - 2;
    long long current_index = 0;
    for (int i = 0; i < len; ++i) {
        if (n_str[i] == '7') {
            current_index += (1LL << (len - 1 - i));
        }
    }
    current_index++;
    long long final_index = total_count + current_index;
    cout << final_index << endl;
    return 0;
}
