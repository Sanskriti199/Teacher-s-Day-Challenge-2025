#include <iostream>
using namespace std;

int main() {
    int n;
    cin >> n;

    if (n <= 1) {
        cout << 0 << endl;
        return 0;
    }

    int score;
    cin >> score;

    int min_score = score;
    int max_score = score;
    int amazing_count = 0;

    for (int i = 1; i < n; ++i) {
        cin >> score;
        if (score > max_score) {
            max_score = score;
            amazing_count++;
        }
        if (score < min_score) {
            min_score = score;
            amazing_count++;
        }
    }

    cout << amazing_count << endl;

    return 0;
}
